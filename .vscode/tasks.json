{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run current Ruby file",
      "type": "shell",
      "command": "bundle",
      "args": ["exec", "ruby", "${file}"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Lint current Ruby file",
      "type": "shell",
      "command": "bundle",
      "args": ["exec", "rubocop", "${file}"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
